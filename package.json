{
  "name": "@kubohiroya/turbowarp-voice-chat",
  "version": "0.4.0",
  "description": "Voice chat with an AI for TurboWarp: combines OpenAI Realtime, browser speech, named functions as tools, and a forced coffee break.",
  "author": {
    "name": "Hiroya Kubo",
    "email": "hiroya@cuc.ac.jp",
    "url": "https://github.com/kubohiroya"
  },
  "license": "MPL-2.0",
  "homepage": "https://github.com/kubohiroya/turbowarp-voice-chat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-voice-chat.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-voice-chat/issues"
  },
  "keywords": [
    "turbowarp",
    "scratch",
    "extension",
    "voice-chat",
    "openai",
    "realtime",
    "speech",
    "vite",
    "typescript"
  ],
  "type": "module",
  "files": [
    "assets/",
    "dist/",
    "src/",
    "README.md",
    "README.ja.md",
    "LICENSE",
    "schemas"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.28.8",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "build": "vite build && vite build --config vite.composition.config.ts && tsc --project tsconfig.build.json",
    "lint": "eslint src tests scripts vite.config.ts vite.composition.config.ts eslint.config.ts",
    "test": "vitest run",
    "docs": "node scripts/generate-readme.ts",
    "docs:check": "node scripts/generate-readme.ts --check",
    "repo:check": "node scripts/check-repo.ts",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run docs:check && pnpm run check:dist && pnpm run types:composition:check && pnpm run repo:check && pnpm run pack:check && pnpm run samples:check",
    "check:dist": "pnpm run build && node scripts/check-dist.ts",
    "types:composition:check": "tsc --project tsconfig.composition-consumer.json",
    "samples:build": "node scripts/build-samples.mjs",
    "samples:check": "node scripts/build-samples.mjs --check && node --test scripts/verify-samples.mjs",
    "pages:build": "node scripts/prepare-pages.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@kubohiroya/turbowarp-extension-manifest": "^0.5.0",
    "@kubohiroya/vite-plugin-turbowarp-extension": "^0.10.0",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "jiti": "^2.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "@kubohiroya/turbowarp-extension-data-editor": "^0.5.0"
  },
  "exports": {
    "./composition": {
      "types": "./dist/types/composition.d.ts",
      "import": "./dist/composition.js"
    },
    "./turbowarp-voice-chat.js": "./dist/turbowarp-voice-chat.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@kubohiroya/turbowarp-named-functions": "^0.4.0",
    "@kubohiroya/turbowarp-openai-realtime-api": "^0.4.0",
    "@kubohiroya/turbowarp-web-speech": "^0.4.0"
  },
  "gitHead": "3155ef2da9dd3b041a053748c92d34306207d802",
  "x-turbowarp-source": {
    "revision": "3155ef2da9dd3b041a053748c92d34306207d802",
    "revisionRole": "base-commit",
    "sourceState": "local-release-overlay"
  }
}
